@model LibraryManagement.Areas.Admin.ViewModels.AdminUserDetailsViewModel

@{
    ViewData["Title"] = "جزئیات کاربر";
}

<div class="admin-user-details-page">

    <div class="admin-user-details-header">

        <div>
            <h1 class="admin-user-details-title">
                جزئیات کاربر
            </h1>

            <p class="admin-user-details-subtitle">
                مشاهده اطلاعات کامل کاربر و مدیریت حساب
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Index"
           class="admin-user-details-back-link">
            بازگشت به لیست کاربران
        </a>

    </div>


    <div class="admin-user-details-grid">

        <!-- Personal Information -->

        <div class="admin-user-details-card">

            <div class="admin-user-details-card-header">
                <h2>اطلاعات شخصی</h2>
            </div>

            <div class="admin-user-details-card-body">

                <div class="admin-user-detail-item">
                    <span class="admin-user-detail-label">
                        شناسه کاربر
                    </span>

                    <span class="admin-user-detail-value">
                        @Model.Id
                    </span>
                </div>

                <div class="admin-user-detail-item">
                    <span class="admin-user-detail-label">
                        نام و نام خانوادگی
                    </span>

                    <span class="admin-user-detail-value">
                        @Model.FullName
                    </span>
                </div>

                <div class="admin-user-detail-item">
                    <span class="admin-user-detail-label">
                        نام پدر
                    </span>

                    <span class="admin-user-detail-value">
                        @Model.FatherName
                    </span>
                </div>

                <div class="admin-user-detail-item">
                    <span class="admin-user-detail-label">
                        تاریخ تولد
                    </span>

                    <span class="admin-user-detail-value">
                        @Model.DateOfBirth.ToPersianDate()
                    </span>
                </div>

                <div class="admin-user-detail-item">
                    <span class="admin-user-detail-label">
                        جنسیت
                    </span>

                    <span class="admin-user-detail-value">
                        @Model.Gender.GetDisplayName()
                    </span>
                </div>

                <div class="admin-user-detail-item">
                    <span class="admin-user-detail-label">
                        تحصیلات
                    </span>

                    <span class="admin-user-detail-value">
                        @Model.Education.GetDisplayName()
                    </span>
                </div>

            </div>
        </div>


        <!-- Contact Information -->

        <div class="admin-user-details-card">

            <div class="admin-user-details-card-header">
                <h2>اطلاعات تماس</h2>
            </div>

            <div class="admin-user-details-card-body">

                <div class="admin-user-detail-item">
                    <span class="admin-user-detail-label">
                        ایمیل
                    </span>

                    <span class="admin-user-detail-value">
                        @Model.Email
                    </span>
                </div>

                <div class="admin-user-detail-item">
                    <span class="admin-user-detail-label">
                        شماره همراه
                    </span>

                    <span class="admin-user-detail-value">
                        @Model.PhoneNumber
                    </span>
                </div>

                <div class="admin-user-detail-item">
                    <span class="admin-user-detail-label">
                        آدرس
                    </span>

                    <span class="admin-user-detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.Address))
                        {
                            @Model.Address
                        }
                        else
                        {
                            <span class="admin-user-empty-value">
                                ثبت نشده
                            </span>
                        }

                    </span>
                </div>

            </div>
        </div>


        <!-- Account Information -->

        <div class="admin-user-details-card">

            <div class="admin-user-details-card-header">
                <h2>اطلاعات حساب</h2>
            </div>

            <div class="admin-user-details-card-body">

                <div class="admin-user-detail-item">

                    <span class="admin-user-detail-label">
                        نام کاربری
                    </span>

                    <span class="admin-user-detail-value">
                        @Model.UserName
                    </span>

                </div>

                <div class="admin-user-detail-item">

                    <span class="admin-user-detail-label">
                        نقش
                    </span>

                    <span class="admin-user-detail-value">
                        @(Model.Role == "Admin" ? "مدیر" : "کاربر")
                    </span>

                </div>

                <div class="admin-user-detail-item">

                    <span class="admin-user-detail-label">
                        وضعیت حساب
                    </span>

                    <span class="admin-user-detail-value">

                        @if (Model.IsActive)
                        {
                            <span class="admin-user-status admin-user-status-active">
                                فعال
                            </span>
                        }
                        else
                        {
                            <span class="admin-user-status admin-user-status-inactive">
                                غیرفعال
                            </span>
                        }

                    </span>

                </div>

            </div>
        </div>


        <!-- Wallet Information -->

        <div class="admin-user-details-card">

            <div class="admin-user-details-card-header">
                <h2>کیف پول</h2>
            </div>

            <div class="admin-user-details-card-body">

                <div class="admin-user-detail-item">

                    <span class="admin-user-detail-label">
                        موجودی
                    </span>

                    <span class="admin-user-detail-value admin-user-wallet-balance">
                        @Model.WalletBalance.ToString("N0") تومان
                    </span>

                </div>

                <div class="admin-user-detail-item">

                    <span class="admin-user-detail-label">
                        وضعیت مالی
                    </span>

                    <span class="admin-user-detail-value">

                        @if (Model.IsDebtor)
                        {
                            <span class="admin-user-status admin-user-status-debtor">
                                بدهکار
                            </span>
                        }
                        else
                        {
                            <span class="admin-user-status admin-user-status-normal">
                                عادی
                            </span>
                        }

                    </span>

                </div>

            </div>
        </div>

    </div>


    <!-- User Management -->

    <div class="admin-user-details-card admin-user-details-management-card">

        <div class="admin-user-details-card-header">
            <h2>مدیریت کاربر</h2>
        </div>

        <div class="admin-user-details-card-body">

            <div class="admin-user-details-actions">

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="admin-user-action-button admin-user-action-edit">
                    ویرایش کاربر
                </a>

                @if (Model.IsActive)
                {
                    <form asp-area="Admin"
                          asp-controller="User"
                          asp-action="Deactivate"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="admin-user-action-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="admin-user-action-button admin-user-action-deactivate">
                            غیرفعال کردن
                        </button>

                    </form>
                }
                else
                {
                    <form asp-area="Admin"
                          asp-controller="User"
                          asp-action="Activate"
                          asp-route-id="@Model.Id"
                          method="post"
                          class="admin-user-action-form">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="admin-user-action-button admin-user-action-activate">
                            فعال کردن
                        </button>

                    </form>
                }

            </div>

        </div>

    </div>


    <!-- User Records -->

    <div class="admin-user-details-card admin-user-details-records-card">

        <div class="admin-user-details-card-header">
            <h2>سوابق کاربر</h2>
        </div>

        <div class="admin-user-details-card-body">

            <div class="admin-user-details-actions">

                <a asp-area="Admin"
                   asp-controller="Loan"
                   asp-action="Index"
                   asp-route-userId="@Model.Id"
                   class="admin-user-action-button admin-user-action-secondary">
                    امانت‌های کاربر
                </a>

                <a asp-area="Admin"
                   asp-controller="Reservation"
                   asp-action="Index"
                   asp-route-userId="@Model.Id"
                   class="admin-user-action-button admin-user-action-secondary">
                    رزروهای کاربر
                </a>

                <a asp-area="Admin"
                   asp-controller="Wallet"
                   asp-action="Transactions"
                   asp-route-userId="@Model.Id"
                   class="admin-user-action-button admin-user-action-secondary">
                    تراکنش‌های کیف پول
                </a>

            </div>

        </div>

    </div>

</div>


@section Styles
{
    <link rel="stylesheet"
          href="~/css/pages/admin/user/details.css"
          asp-append-version="true" />
}