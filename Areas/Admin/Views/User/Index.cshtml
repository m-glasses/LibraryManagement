@model LibraryManagement.Areas.Admin.ViewModels.AdminUserIndexViewModel

@{
    ViewData["Title"] = "مدیریت کاربران";

    var filter = Model.Filter
        ?? new LibraryManagement.Areas.Admin.ViewModels.AdminUserFilterViewModel();

    var currentPage = Math.Max(1, filter.Page);
    var totalPages = Model.TotalPages;
}

<div class="admin-user-page">

    <header class="admin-user-page-header">
        <div>
            <h1 class="admin-user-page-title">مدیریت کاربران</h1>
            <p class="admin-user-page-subtitle">
                فهرست کاربران، نقش‌ها و وضعیت کیف‌پول آن‌ها
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="CreateUser"
           class="admin-user-create-link">
            <span aria-hidden="true">+</span>
            افزودن کاربر
        </a>
    </header>

    <section class="admin-user-filter-card"
             aria-labelledby="admin-user-filter-title">

        <header class="admin-user-filter-header">
            <h2 id="admin-user-filter-title" class="admin-user-filter-title">
                جست‌وجو و فیلتر
            </h2>
            <p class="admin-user-filter-description">
                کاربران را بر اساس مشخصات، نقش و وضعیت مالی پیدا کنید.
            </p>
        </header>

        <form asp-area="Admin"
              asp-controller="User"
              asp-action="Index"
              method="get"
              class="admin-user-filter-form">

            <div class="admin-user-filter-group admin-user-search-group">
                <label for="SearchTerm">جست‌وجو</label>
                <input id="SearchTerm"
                       name="SearchTerm"
                       type="search"
                       value="@filter.SearchTerm"
                       class="admin-user-filter-input"
                       placeholder="نام، ایمیل یا شماره همراه"
                       autocomplete="off" />
            </div>

            <div class="admin-user-filter-group">
                <label for="Role">نقش کاربر</label>
                <select id="Role"
                        name="Role"
                        class="admin-user-filter-input">
                    <option value="" selected="@(string.IsNullOrEmpty(filter.Role))">
                        همه نقش‌ها
                    </option>
                    <option value="User" selected="@(filter.Role == "User")">
                        کاربر
                    </option>
                    <option value="Admin" selected="@(filter.Role == "Admin")">
                        مدیر
                    </option>
                </select>
            </div>

            <div class="admin-user-filter-group">
                <label for="IsDebtor">وضعیت مالی</label>
                <select id="IsDebtor"
                        name="IsDebtor"
                        class="admin-user-filter-input">
                    <option value="" selected="@(filter.IsDebtor is null)">
                        همه وضعیت‌ها
                    </option>
                    <option value="true" selected="@(filter.IsDebtor == true)">
                        بدهکار
                    </option>
                    <option value="false" selected="@(filter.IsDebtor == false)">
                        عادی
                    </option>
                </select>
            </div>

            <div class="admin-user-filter-group">
                <label for="PageSize">تعداد در هر صفحه</label>
                <select id="PageSize"
                        name="PageSize"
                        class="admin-user-filter-input">
                    <option value="10" selected="@(filter.PageSize == 10)">۱۰</option>
                    <option value="20" selected="@(filter.PageSize == 20)">۲۰</option>
                    <option value="50" selected="@(filter.PageSize == 50)">۵۰</option>
                </select>
            </div>

            <input type="hidden" name="Page" value="1" />
            <input type="hidden" name="SortBy" value="@filter.SortBy" />
            <input type="hidden" name="SortDescending" value="@filter.SortDescending" />

            <div class="admin-user-filter-actions">
                <button type="submit" class="admin-user-filter-submit">
                    اعمال فیلتر
                </button>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="admin-user-filter-reset">
                    پاک کردن فیلترها
                </a>
            </div>
        </form>
    </section>

    <section class="admin-user-list-card"
             aria-labelledby="admin-user-list-title">

        <header class="admin-user-list-header">
            <div>
                <h2 id="admin-user-list-title" class="admin-user-list-title">
                    فهرست کاربران
                </h2>
                <p class="admin-user-list-description">
                    مشخصات حساب، نقش و موجودی کیف‌پول
                </p>
            </div>

            <span class="admin-user-list-count">
                @Model.TotalCount کاربر
            </span>
        </header>

        @if (Model.Users.Count == 0)
        {
            <div class="admin-user-empty-state">
                <h3>کاربری پیدا نشد</h3>
                <p>
                    کاربری با معیارهای انتخاب‌شده وجود ندارد.
                    فیلترها را تغییر دهید یا پاک کنید.
                </p>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="admin-user-filter-reset">
                    نمایش همه کاربران
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive admin-user-table-wrapper">
                <table class="admin-user-table">
                    <thead>
                        <tr>
                            <th scope="col">شناسه</th>

                            <th scope="col">
                                <a asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="Index"
                                   asp-route-SearchTerm="@filter.SearchTerm"
                                   asp-route-Role="@filter.Role"
                                   asp-route-IsDebtor="@filter.IsDebtor"
                                   asp-route-PageSize="@filter.PageSize"
                                   asp-route-Page="1"
                                   asp-route-SortBy="Name"
                                   asp-route-SortDescending="@(filter.SortBy == "Name" && !filter.SortDescending)"
                                   class="admin-user-sort-link">
                                    نام و نام خانوادگی
                                    @if (filter.SortBy == "Name")
                                    {
                                        <span aria-hidden="true">
                                            @(filter.SortDescending ? "▼" : "▲")
                                        </span>
                                    }
                                </a>
                            </th>

                            <th scope="col">
                                <a asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="Index"
                                   asp-route-SearchTerm="@filter.SearchTerm"
                                   asp-route-Role="@filter.Role"
                                   asp-route-IsDebtor="@filter.IsDebtor"
                                   asp-route-PageSize="@filter.PageSize"
                                   asp-route-Page="1"
                                   asp-route-SortBy="Email"
                                   asp-route-SortDescending="@(filter.SortBy == "Email" && !filter.SortDescending)"
                                   class="admin-user-sort-link">
                                    ایمیل
                                    @if (filter.SortBy == "Email")
                                    {
                                        <span aria-hidden="true">
                                            @(filter.SortDescending ? "▼" : "▲")
                                        </span>
                                    }
                                </a>
                            </th>

                            <th scope="col">شماره همراه</th>
                            <th scope="col">نقش</th>

                            <th scope="col">
                                <a asp-area="Admin"
                                   asp-controller="User"
                                   asp-action="Index"
                                   asp-route-SearchTerm="@filter.SearchTerm"
                                   asp-route-Role="@filter.Role"
                                   asp-route-IsDebtor="@filter.IsDebtor"
                                   asp-route-PageSize="@filter.PageSize"
                                   asp-route-Page="1"
                                   asp-route-SortBy="WalletBalance"
                                   asp-route-SortDescending="@(filter.SortBy == "WalletBalance" && !filter.SortDescending)"
                                   class="admin-user-sort-link">
                                    موجودی کیف‌پول
                                    @if (filter.SortBy == "WalletBalance")
                                    {
                                        <span aria-hidden="true">
                                            @(filter.SortDescending ? "▼" : "▲")
                                        </span>
                                    }
                                </a>
                            </th>

                            <th scope="col">وضعیت مالی</th>
                            <th scope="col">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="admin-user-id">@user.Id</td>

                                <td class="admin-user-full-name">
                                    @user.FullName
                                </td>

                                <td class="admin-user-email">
                                    @(string.IsNullOrWhiteSpace(user.Email)
                                        ? "—"
                                        : user.Email)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                        ? "—"
                                        : user.PhoneNumber)
                                </td>

                                <td>
                                    <span class="admin-user-role">
                                        @user.RoleDisplayName
                                    </span>
                                </td>

                                <td class="admin-user-wallet-balance @(user.WalletBalance < 0 ? "is-negative" : "")">
                                    <span dir="ltr">@user.WalletBalance.ToString("N0")</span>
                                    <span class="admin-user-currency">تومان</span>
                                </td>

                                <td>
                                    @if (user.IsDebtor)
                                    {
                                        <span class="admin-user-status admin-user-status-debtor">
                                            بدهکار
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-user-status admin-user-status-normal">
                                            عادی
                                        </span>
                                    }
                                </td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="User"
                                       asp-action="Details"
                                       asp-route-id="@user.Id"
                                       class="admin-user-details-link">
                                        جزئیات
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="admin-user-list-footer">
                <span>صفحه @currentPage از @totalPages</span>
                <span>@Model.Users.Count مورد در این صفحه</span>
            </footer>

            @if (totalPages > 1)
            {
                <nav class="admin-user-pagination" aria-label="صفحه‌بندی کاربران">
                    @if (currentPage > 1)
                    {
                        <a asp-area="Admin"
                           asp-controller="User"
                           asp-action="Index"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-Role="@filter.Role"
                           asp-route-IsDebtor="@filter.IsDebtor"
                           asp-route-PageSize="@filter.PageSize"
                           asp-route-SortBy="@filter.SortBy"
                           asp-route-SortDescending="@filter.SortDescending"
                           asp-route-Page="@(currentPage - 1)"
                           class="admin-user-pagination-link">
                            قبلی
                        </a>
                    }
                    else
                    {
                        <span class="admin-user-pagination-link is-disabled">قبلی</span>
                    }

                    <span class="admin-user-pagination-current">
                        @currentPage / @totalPages
                    </span>

                    @if (currentPage < totalPages)
                    {
                        <a asp-area="Admin"
                           asp-controller="User"
                           asp-action="Index"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-Role="@filter.Role"
                           asp-route-IsDebtor="@filter.IsDebtor"
                           asp-route-PageSize="@filter.PageSize"
                           asp-route-SortBy="@filter.SortBy"
                           asp-route-SortDescending="@filter.SortDescending"
                           asp-route-Page="@(currentPage + 1)"
                           class="admin-user-pagination-link">
                            بعدی
                        </a>
                    }
                    else
                    {
                        <span class="admin-user-pagination-link is-disabled">بعدی</span>
                    }
                </nav>
            }
        }
    </section>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/admin/user/index.css"
          asp-append-version="true" />
}
