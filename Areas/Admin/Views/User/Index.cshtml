@model LibraryManagement.Areas.Admin.ViewModels.AdminUserIndexViewModel

@{
    ViewData["Title"] = "مدیریت کاربران";
}

<div class="admin-user-page">
    <div class="admin-user-page-header">
        <div>
            <h1 class="admin-user-page-title">
                مدیریت کاربران
            </h1>

            <p class="admin-user-page-subtitle">
                فهرست کاربران ثبت‌شده در سامانه
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="CreateUser"
           class="admin-user-create-link">
            افزودن کاربر
        </a>
    </div>

    <!-- Filters -->
    <div class="admin-user-filter-card">
        <form asp-area="Admin"
              asp-controller="User"
              asp-action="Index"
              method="get"
              class="admin-user-filter-form">

            <div class="admin-user-filter-group">
                <label for="SearchTerm"
                       class="admin-user-filter-label">
                    جستجو
                </label>

                <input id="SearchTerm"
                       name="SearchTerm"
                       value="@Model.Filter.SearchTerm"
                       class="admin-user-filter-input"
                       placeholder="نام، ایمیل یا شماره همراه..." />
            </div>

            <div class="admin-user-filter-group">
                <label for="Role"
                       class="admin-user-filter-label">
                    نقش
                </label>

                <select id="Role"
                        name="Role"
                        class="admin-user-filter-input">

                    <option value=""
                            selected="@(Model.Filter.Role == null || Model.Filter.Role == "")">
                        همه نقش‌ها
                    </option>

                    <option value="User"
                            selected="@(Model.Filter.Role == "User")">
                        کاربر
                    </option>

                    <option value="Admin"
                            selected="@(Model.Filter.Role == "Admin")">
                        مدیر
                    </option>
                </select>
            </div>

            <div class="admin-user-filter-group">
                <label for="IsDebtor"
                       class="admin-user-filter-label">
                    وضعیت مالی
                </label>

                <select id="IsDebtor"
                        name="IsDebtor"
                        class="admin-user-filter-input">

                    <option value=""
                            selected="@(Model.Filter.IsDebtor == null)">
                        همه
                    </option>

                    <option value="true"
                            selected="@(Model.Filter.IsDebtor == true)">
                        بدهکار
                    </option>

                    <option value="false"
                            selected="@(Model.Filter.IsDebtor == false)">
                        عادی
                    </option>
                </select>
            </div>

            <input type="hidden"
                   name="PageSize"
                   value="@Model.Filter.PageSize" />

            <input type="hidden"
                   name="Page"
                   value="1" />

            <div class="admin-user-filter-actions">
                <button type="submit"
                        class="admin-user-filter-submit">
                    جستجو
                </button>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="admin-user-filter-reset">
                    پاک کردن فیلترها
                </a>
            </div>
        </form>
    </div>

    <!-- User List -->
    @if (!Model.Users.Any())
    {
        <div class="admin-user-empty-state">
            <p>
                کاربری با این مشخصات پیدا نشد.
            </p>
        </div>
    }
    else
    {
        <div class="admin-user-list-card">
            <div class="admin-user-list-header">
                <h2 class="admin-user-list-title">
                    لیست کاربران
                </h2>

                <span class="admin-user-list-count">
                    @Model.TotalCount کاربر
                </span>
            </div>

            <div class="table-responsive">
                <table class="admin-user-table">
                    <thead>
                        <tr>
                            <th>
                                @Html.DisplayNameFor(model => model.Users.First().Id)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.Users.First().FullName)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.Users.First().Email)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.Users.First().PhoneNumber)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.Users.First().Role)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.Users.First().WalletBalance)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.Users.First().IsDebtor)
                            </th>

                            <th class="admin-user-table-actions">
                                عملیات
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    @user.Id
                                </td>

                                <td class="admin-user-full-name">
                                    @user.FullName
                                </td>

                                <td class="admin-user-email">
                                    @user.Email
                                </td>

                                <td class="admin-user-phone">
                                    @user.PhoneNumber
                                </td>

                                <td>
                                    @user.RoleDisplayName
                                </td>

                                <td class="admin-user-wallet-balance">
                                    @user.WalletBalance.ToString("N0")
                                </td>

                                <td>
                                    @if (user.IsDebtor)
                                    {
                                        <span class="admin-user-status admin-user-status-debtor">
                                            بدهکار
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-user-status admin-user-status-normal">
                                            عادی
                                        </span>
                                    }
                                </td>

                                <td class="admin-user-table-actions">
                                    <a asp-area="Admin"
                                       asp-controller="User"
                                       asp-action="Details"
                                       asp-route-id="@user.Id"
                                       class="admin-user-details-link">
                                        جزئیات
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <nav class="admin-user-pagination"
                 aria-label="صفحه‌بندی کاربران">

                <ul class="admin-user-pagination-list">
                    @if (Model.Filter.Page > 1)
                    {
                        <li class="admin-user-pagination-item">
                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="Index"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-Role="@Model.Filter.Role"
                               asp-route-IsDebtor="@Model.Filter.IsDebtor"
                               asp-route-Page="@(Model.Filter.Page - 1)"
                               asp-route-PageSize="@Model.Filter.PageSize"
                               class="admin-user-pagination-link">
                                قبلی
                            </a>
                        </li>
                    }

                    @for (var pageNumber = 1;
                          pageNumber <= Model.TotalPages;
                          pageNumber++)
                    {
                        <li class="admin-user-pagination-item">
                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="Index"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-Role="@Model.Filter.Role"
                               asp-route-IsDebtor="@Model.Filter.IsDebtor"
                               asp-route-Page="@pageNumber"
                               asp-route-PageSize="@Model.Filter.PageSize"
                               class="admin-user-pagination-link @(pageNumber == Model.Filter.Page ? "active" : "")">
                                @pageNumber
                            </a>
                        </li>
                    }

                    @if (Model.Filter.Page < Model.TotalPages)
                    {
                        <li class="admin-user-pagination-item">
                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="Index"
                               asp-route-SearchTerm="@Model.Filter.SearchTerm"
                               asp-route-Role="@Model.Filter.Role"
                               asp-route-IsDebtor="@Model.Filter.IsDebtor"
                               asp-route-Page="@(Model.Filter.Page + 1)"
                               asp-route-PageSize="@Model.Filter.PageSize"
                               class="admin-user-pagination-link">
                                بعدی
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/admin/user/index.css"
          asp-append-version="true" />
}