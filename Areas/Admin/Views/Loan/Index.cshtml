@model LibraryManagement.Areas.Admin.ViewModels.Loans.AdminLoanIndexViewModel

@{
    ViewData["Title"] = "مدیریت امانت‌ها";

    var filter = Model.Filter;
    var currentPage = Math.Max(1, filter.Page);
    var totalPages = Model.TotalPages;
}

<div class="admin-loan-page">

    <header class="admin-loan-page-header">
        <div>
            <h1 class="admin-loan-page-title">مدیریت امانت‌ها</h1>
            <p class="admin-loan-page-subtitle">
                جست‌وجو، فیلتر و مدیریت امانت‌های ثبت‌شده در کتابخانه
            </p>
        </div>
    </header>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="admin-loan-error-message" role="alert">
            @errorMessage
        </div>
    }

    <section class="admin-loan-filter-card"
             aria-labelledby="admin-loan-filter-title">

        <header class="admin-loan-section-header">
            <h2 id="admin-loan-filter-title" class="admin-loan-section-title">
                جست‌وجو و فیلتر
            </h2>

            <p class="admin-loan-section-description">
                امانت‌ها را بر اساس مشخصات کاربر، کتاب، وضعیت و تاریخ محدود کنید.
            </p>
        </header>

        <form asp-area="Admin"
              asp-controller="Loan"
              asp-action="Index"
              method="get"
              class="admin-loan-filter-form">

            <div class="admin-loan-filter-group admin-loan-search-group">
                <label for="SearchTerm">جست‌وجو</label>
                <input id="SearchTerm"
                       name="SearchTerm"
                       type="search"
                       value="@filter.SearchTerm"
                       class="admin-loan-filter-input"
                       placeholder="نام، نام خانوادگی، ایمیل، عنوان کتاب یا شماره اموال"
                       autocomplete="off" />
            </div>

            <div class="admin-loan-filter-group">
                <label for="Status">وضعیت امانت</label>
                <select id="Status"
                        name="Status"
                        class="admin-loan-filter-input">

                    <option value="" selected="@(filter.Status is null)">
                        همه وضعیت‌ها
                    </option>

                    <option value="Active"
                            selected="@(filter.Status == LoanStatus.Active)">
                        فعال
                    </option>

                    <option value="ReturnPending"
                            selected="@(filter.Status == LoanStatus.ReturnPending)">
                        در انتظار تأیید بازگشت
                    </option>

                    <option value="Completed"
                            selected="@(filter.Status == LoanStatus.Completed)">
                        خاتمه‌یافته
                    </option>
                </select>
            </div>

            <div class="admin-loan-filter-group">
                <label for="SortBy">مرتب‌سازی بر اساس</label>
                <select id="SortBy"
                        name="SortBy"
                        class="admin-loan-filter-input">

                    <option value=""
                            selected="@string.IsNullOrWhiteSpace(filter.SortBy)">
                        پیش‌فرض
                    </option>

                    <option value="Name"
                            selected="@string.Equals(filter.SortBy, "Name", StringComparison.OrdinalIgnoreCase)">
                        نام کاربر
                    </option>

                    <option value="Family"
                            selected="@string.Equals(filter.SortBy, "Family", StringComparison.OrdinalIgnoreCase)">
                        نام خانوادگی
                    </option>

                    <option value="Email"
                            selected="@string.Equals(filter.SortBy, "Email", StringComparison.OrdinalIgnoreCase)">
                        ایمیل
                    </option>

                    <option value="Title"
                            selected="@string.Equals(filter.SortBy, "Title", StringComparison.OrdinalIgnoreCase)">
                        عنوان کتاب
                    </option>

                    <option value="Author"
                            selected="@string.Equals(filter.SortBy, "Author", StringComparison.OrdinalIgnoreCase)">
                        نویسنده
                    </option>

                    <option value="InventoryNumber"
                            selected="@string.Equals(filter.SortBy, "InventoryNumber", StringComparison.OrdinalIgnoreCase)">
                        شماره اموال
                    </option>

                    <option value="StartDate"
                            selected="@string.Equals(filter.SortBy, "StartDate", StringComparison.OrdinalIgnoreCase)">
                        تاریخ شروع امانت
                    </option>

                    <option value="DueDate"
                            selected="@string.Equals(filter.SortBy, "DueDate", StringComparison.OrdinalIgnoreCase)">
                        تاریخ سررسید
                    </option>

                    <option value="ReturnDate"
                            selected="@string.Equals(filter.SortBy, "ReturnDate", StringComparison.OrdinalIgnoreCase)">
                        تاریخ بازگشت
                    </option>
                </select>
            </div>

            <div class="admin-loan-filter-group">
                <label for="PageSize">تعداد در هر صفحه</label>
                <select id="PageSize"
                        name="PageSize"
                        class="admin-loan-filter-input">

                    <option value="10" selected="@(filter.PageSize == 10)">۱۰</option>
                    <option value="20" selected="@(filter.PageSize == 20)">۲۰</option>
                    <option value="50" selected="@(filter.PageSize == 50)">۵۰</option>
                </select>
            </div>

            <div class="admin-loan-filter-group">
                <label for="SortDescending">جهت مرتب‌سازی</label>
                <select id="SortDescending"
                        name="SortDescending"
                        class="admin-loan-filter-input">

                    <option value="false" selected="@(!filter.SortDescending)">
                        صعودی
                    </option>

                    <option value="true" selected="@(filter.SortDescending)">
                        نزولی
                    </option>
                </select>
            </div>

            <div class="admin-loan-filter-divider">
                <span>محدوده‌های زمانی</span>
            </div>

            <div class="admin-loan-filter-group">
                <label for="StartDateFromDisplay">شروع امانت از</label>
                <input id="StartDateFromDisplay"
                       type="text"
                       class="admin-loan-filter-input admin-loan-date-input"
                       value="@(filter.StartDateFrom?.ToPersianDate())"
                       data-jdp
                       data-jdp-target-value-input="#StartDateFrom"
                       data-jdp-target-value-type="gregorian"
                       placeholder="انتخاب تاریخ"
                       autocomplete="off" />

                <input id="StartDateFrom"
                       name="StartDateFrom"
                       type="hidden"
                       value="@(filter.StartDateFrom?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="admin-loan-filter-group">
                <label for="StartDateToDisplay">شروع امانت تا</label>
                <input id="StartDateToDisplay"
                       type="text"
                       class="admin-loan-filter-input admin-loan-date-input"
                       value="@(filter.StartDateTo?.ToPersianDate())"
                       data-jdp
                       data-jdp-target-value-input="#StartDateTo"
                       data-jdp-target-value-type="gregorian"
                       placeholder="انتخاب تاریخ"
                       autocomplete="off" />

                <input id="StartDateTo"
                       name="StartDateTo"
                       type="hidden"
                       value="@(filter.StartDateTo?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="admin-loan-filter-group">
                <label for="DueDateFromDisplay">سررسید از</label>
                <input id="DueDateFromDisplay"
                       type="text"
                       class="admin-loan-filter-input admin-loan-date-input"
                       value="@(filter.DueDateFrom?.ToPersianDate())"
                       data-jdp
                       data-jdp-target-value-input="#DueDateFrom"
                       data-jdp-target-value-type="gregorian"
                       placeholder="انتخاب تاریخ"
                       autocomplete="off" />

                <input id="DueDateFrom"
                       name="DueDateFrom"
                       type="hidden"
                       value="@(filter.DueDateFrom?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="admin-loan-filter-group">
                <label for="DueDateToDisplay">سررسید تا</label>
                <input id="DueDateToDisplay"
                       type="text"
                       class="admin-loan-filter-input admin-loan-date-input"
                       value="@(filter.DueDateTo?.ToPersianDate())"
                       data-jdp
                       data-jdp-target-value-input="#DueDateTo"
                       data-jdp-target-value-type="gregorian"
                       placeholder="انتخاب تاریخ"
                       autocomplete="off" />

                <input id="DueDateTo"
                       name="DueDateTo"
                       type="hidden"
                       value="@(filter.DueDateTo?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="admin-loan-filter-group">
                <label for="ReturnDateFromDisplay">تاریخ بازگشت از</label>
                <input id="ReturnDateFromDisplay"
                       type="text"
                       class="admin-loan-filter-input admin-loan-date-input"
                       value="@(filter.ReturnDateFrom?.ToPersianDate())"
                       data-jdp
                       data-jdp-target-value-input="#ReturnDateFrom"
                       data-jdp-target-value-type="gregorian"
                       placeholder="انتخاب تاریخ"
                       autocomplete="off" />

                <input id="ReturnDateFrom"
                       name="ReturnDateFrom"
                       type="hidden"
                       value="@(filter.ReturnDateFrom?.ToString("yyyy-MM-dd"))" />
            </div>

            <div class="admin-loan-filter-group">
                <label for="ReturnDateToDisplay">تاریخ بازگشت تا</label>
                <input id="ReturnDateToDisplay"
                       type="text"
                       class="admin-loan-filter-input admin-loan-date-input"
                       value="@(filter.ReturnDateTo?.ToPersianDate())"
                       data-jdp
                       data-jdp-target-value-input="#ReturnDateTo"
                       data-jdp-target-value-type="gregorian"
                       placeholder="انتخاب تاریخ"
                       autocomplete="off" />

                <input id="ReturnDateTo"
                       name="ReturnDateTo"
                       type="hidden"
                       value="@(filter.ReturnDateTo?.ToString("yyyy-MM-dd"))" />
            </div>

            <input type="hidden" name="Page" value="1" />

            <div class="admin-loan-filter-actions">
                <button type="submit" class="admin-loan-filter-submit">
                    اعمال فیلترها
                </button>

                <a asp-area="Admin"
                   asp-controller="Loan"
                   asp-action="Index"
                   class="admin-loan-filter-reset">
                    پاک کردن فیلترها
                </a>
            </div>
        </form>
    </section>

    <section class="admin-loan-list-card"
             aria-labelledby="admin-loan-list-title">

        <header class="admin-loan-list-header">
            <div>
                <h2 id="admin-loan-list-title" class="admin-loan-section-title">
                    فهرست امانت‌ها
                </h2>

                <p class="admin-loan-section-description">
                    اطلاعات کاربران، کتاب‌ها و وضعیت امانت‌ها
                </p>
            </div>

            <span class="admin-loan-list-count">
                @Model.TotalCount امانت
            </span>
        </header>

        @if (Model.Loans.Count == 0)
        {
            <div class="admin-loan-empty-state">
                <h3>امانتی پیدا نشد</h3>

                <p>
                    با معیارهای انتخاب‌شده امانتی پیدا نشد.
                    فیلترها را تغییر دهید یا پاک کنید.
                </p>

                <a asp-area="Admin"
                   asp-controller="Loan"
                   asp-action="Index"
                   class="admin-loan-filter-reset">
                    نمایش همه امانت‌ها
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive admin-loan-table-wrapper">
                <table class="admin-loan-table">
                    <thead>
                        <tr>
                            <th scope="col">شناسه</th>
                            <th scope="col">نام امانت‌گیرنده</th>
                            <th scope="col">ایمیل</th>
                            <th scope="col">عنوان کتاب</th>
                            <th scope="col">نویسنده</th>
                            <th scope="col">شماره اموال</th>
                            <th scope="col">شروع امانت</th>
                            <th scope="col">سررسید</th>
                            <th scope="col">تاریخ بازگشت</th>
                            <th scope="col">وضعیت</th>
                            <th scope="col">مبلغ نهایی</th>
                            <th scope="col">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var loan in Model.Loans)
                        {
                            <tr>
                                <td class="admin-loan-id">
                                    @loan.LoanId
                                </td>

                                <td class="admin-loan-user">
                                    @loan.UserFullName
                                </td>

                                <td class="admin-loan-email">
                                    @loan.UserEmail
                                </td>

                                <td class="admin-loan-book-title">
                                    @loan.BookTitle
                                </td>

                                <td>@loan.Author</td>

                                <td class="admin-loan-inventory-number">
                                    @loan.InventoryNumber
                                </td>

                                <td class="admin-loan-date">
                                    @loan.StartDate.ToPersianDate()
                                </td>

                                <td class="admin-loan-date">
                                    @loan.DueDate.ToPersianDate()
                                </td>

                                <td class="admin-loan-date">
                                    @if (loan.ReturnDate.HasValue)
                                    {
                                        @loan.ReturnDate.Value.ToPersianDate()
                                    }
                                    else
                                    {
                                        <span class="admin-loan-not-returned">—</span>
                                    }
                                </td>

                                <td>
                                    <span class="admin-loan-status
                                        @(loan.Status switch
                                          {
                                              LoanStatus.Active => "admin-loan-status-active",
                                              LoanStatus.ReturnPending => "admin-loan-status-pending",
                                              LoanStatus.Completed => "admin-loan-status-completed",
                                              _ => "admin-loan-status-unknown"
                                          })">

                                        @(loan.Status switch
                                        {
                                            LoanStatus.Active => "فعال",
                                            LoanStatus.ReturnPending => "در انتظار تأیید",
                                            LoanStatus.Completed => "خاتمه‌یافته",
                                            _ => "نامشخص"
                                        })
                                    </span>
                                </td>

                                <td class="admin-loan-amount">
                                    @loan.FinalAmount.ToString("N0")
                                </td>

                                <td class="admin-loan-table-actions">
                                    <div class="admin-loan-row-actions">
                                        <a asp-area="Admin"
                                           asp-controller="Loan"
                                           asp-action="Details"
                                           asp-route-loanId="@loan.LoanId"
                                           class="admin-loan-details-link">
                                            جزئیات
                                        </a>

                                        @if (loan.Status is LoanStatus.Active or LoanStatus.ReturnPending)
                                        {
                                            <button type="button"
                                                    class="admin-loan-return-button"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#confirmReturnModal"
                                                    data-loan-id="@loan.LoanId">
                                                بازگشت
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="admin-loan-list-footer">
                <span>صفحه @currentPage از @totalPages</span>
                <span>@Model.Loans.Count مورد در این صفحه</span>
            </footer>

            @if (totalPages > 1)
            {
                <nav class="admin-loan-pagination"
                     aria-label="صفحه‌بندی امانت‌ها">

                    @if (currentPage > 1)
                    {
                        <a asp-area="Admin"
                           asp-controller="Loan"
                           asp-action="Index"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-Status="@filter.Status"
                           asp-route-StartDateFrom="@filter.StartDateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-StartDateTo="@filter.StartDateTo?.ToString("yyyy-MM-dd")"
                           asp-route-DueDateFrom="@filter.DueDateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-DueDateTo="@filter.DueDateTo?.ToString("yyyy-MM-dd")"
                           asp-route-ReturnDateFrom="@filter.ReturnDateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-ReturnDateTo="@filter.ReturnDateTo?.ToString("yyyy-MM-dd")"
                           asp-route-SortBy="@filter.SortBy"
                           asp-route-SortDescending="@filter.SortDescending"
                           asp-route-PageSize="@filter.PageSize"
                           asp-route-Page="@(currentPage - 1)"
                           class="admin-loan-pagination-link">
                            قبلی
                        </a>
                    }
                    else
                    {
                        <span class="admin-loan-pagination-link is-disabled"
                              aria-disabled="true">
                            قبلی
                        </span>
                    }

                    <span class="admin-loan-pagination-current"
                          aria-current="page">
                        @currentPage / @totalPages
                    </span>

                    @if (currentPage < totalPages)
                    {
                        <a asp-area="Admin"
                           asp-controller="Loan"
                           asp-action="Index"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-Status="@filter.Status"
                           asp-route-StartDateFrom="@filter.StartDateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-StartDateTo="@filter.StartDateTo?.ToString("yyyy-MM-dd")"
                           asp-route-DueDateFrom="@filter.DueDateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-DueDateTo="@filter.DueDateTo?.ToString("yyyy-MM-dd")"
                           asp-route-ReturnDateFrom="@filter.ReturnDateFrom?.ToString("yyyy-MM-dd")"
                           asp-route-ReturnDateTo="@filter.ReturnDateTo?.ToString("yyyy-MM-dd")"
                           asp-route-SortBy="@filter.SortBy"
                           asp-route-SortDescending="@filter.SortDescending"
                           asp-route-PageSize="@filter.PageSize"
                           asp-route-Page="@(currentPage + 1)"
                           class="admin-loan-pagination-link">
                            بعدی
                        </a>
                    }
                    else
                    {
                        <span class="admin-loan-pagination-link is-disabled"
                              aria-disabled="true">
                            بعدی
                        </span>
                    }
                </nav>
            }
        }
    </section>
</div>

<partial name="_ConfirmReturnModal"
         model="new ConfirmReturnViewModel()" />

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/admin/loan/index.css"
          asp-append-version="true" />
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (window.jalaliDatepicker) {
                jalaliDatepicker.startWatch({
                    targetValueInput: "attr",
                    targetValueType: "attr",
                    zIndex: 1060
                });
            }
        });
    </script>
}