@model LibraryManagement.Areas.Admin.ViewModels.Book.AdminBookDetailsViewModel

@{
    ViewData["Title"] = "جزئیات کتاب";
}

<div class="admin-book-details-page">

    <div class="admin-book-page-header">
        <div>
            <h1 class="admin-book-page-title">جزئیات کتاب</h1>
            <p class="admin-book-page-subtitle">
                مشخصات و وضعیت موجودی کتاب
            </p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="admin-book-error-message" role="alert">
            @errorMessage
        </div>
    }

    <div class="admin-book-details-card">

        @* مشخصات کتاب *@
        <section class="admin-book-details-section">
            <div class="admin-book-details-section-header">
                <h2>مشخصات کتاب</h2>
            </div>

            <dl class="admin-book-details-grid">

                <div class="admin-book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Id)</dt>
                    <dd>@Model.Id</dd>
                </div>

                <div class="admin-book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Title)</dt>
                    <dd>@Model.Title</dd>
                </div>

                <div class="admin-book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Author)</dt>
                    <dd>@Model.Author</dd>
                </div>

                <div class="admin-book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Publisher)</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(Model.Publisher)
                            ? "ثبت نشده"
                            : Model.Publisher)
                    </dd>
                </div>

                <div class="admin-book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.PublicationYear)</dt>
                    <dd>@Model.PublicationYear</dd>
                </div>

                <div class="admin-book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.PublicationSeason)</dt>
                    <dd>
                        @switch (Model.PublicationSeason)
                        {
                            case PublicationSeason.Spring:
                                @:بهار
                                break;

                            case PublicationSeason.Summer:
                                @:تابستان
                                break;

                            case PublicationSeason.Autumn:
                                @:پاییز
                                break;

                            case PublicationSeason.Winter:
                                @:زمستان
                                break;

                            default:
                                @:ثبت نشده
                                break;
                        }
                    </dd>
                </div>

                <div class="admin-book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.PageCount)</dt>
                    <dd>@Model.PageCount</dd>
                </div>

                <div class="admin-book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Edition)</dt>
                    <dd>@Model.Edition</dd>
                </div>

                <div class="admin-book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Volume)</dt>
                    <dd>@Model.Volume</dd>
                </div>

            </dl>
        </section>

        @* وضعیت موجودی *@
        <section class="admin-book-details-section admin-book-inventory-section">
            <div class="admin-book-details-section-header">
                <h2>وضعیت موجودی</h2>
            </div>

            <dl class="admin-book-inventory-grid">

                <div class="admin-book-inventory-item">
                    <dt>@Html.DisplayNameFor(model => model.TotalCopies)</dt>
                    <dd>@Model.TotalCopies</dd>
                </div>

                <div class="admin-book-inventory-item">
                    <dt>@Html.DisplayNameFor(model => model.AvailableCopies)</dt>
                    <dd>@Model.AvailableCopies</dd>
                </div>

                <div class="admin-book-inventory-item">
                    <dt>وضعیت</dt>
                    <dd>
                        @if (Model.AvailableCopies > 0)
                        {
                            <span class="admin-book-status admin-book-status-available">
                                موجود
                            </span>
                        }
                        else
                        {
                            <span class="admin-book-status admin-book-status-unavailable">
                                ناموجود
                            </span>
                        }
                    </dd>
                </div>

                <div class="admin-book-inventory-item">
                    <dt>@Html.DisplayNameFor(model => model.ActiveReservations)</dt>
                    <dd>@Model.ActiveReservations</dd>
                </div>

            </dl>
        </section>

    </div>

    @* عملیات مدیریتی *@
    <div class="admin-book-details-actions">

        <a asp-area="Admin"
           asp-controller="Book"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="admin-book-details-action admin-book-details-action-primary">
            ویرایش کتاب
        </a>

        <a asp-area="Admin"
           asp-controller="BookCopy"
           asp-action="Index"
           asp-route-bookId="@Model.Id"
           class="admin-book-details-action">
            مشاهده نسخه‌های کتاب
        </a>

        <a asp-area="Admin"
           asp-controller="Reservation"
           asp-action="Index"
           asp-route-bookId="@Model.Id"
           class="admin-book-details-action">
            مشاهده رزروهای کتاب
        </a>

        <a asp-area="Admin"
           asp-controller="Book"
           asp-action="Index"
           class="admin-book-details-action">
            بازگشت به فهرست کتاب‌ها
        </a>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/admin/book/details.css"
          asp-append-version="true" />
}
