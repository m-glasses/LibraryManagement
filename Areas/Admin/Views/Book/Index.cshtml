@model LibraryManagement.Areas.Admin.ViewModels.AdminBookIndexViewModel

@{
    ViewData["Title"] = "مدیریت کتاب‌ها";

    var filter = Model.Filter;
    var currentPage = Math.Max(1, filter.Page);
    var totalPages = Model.TotalPages;
}

<div class="admin-book-page">

    <header class="admin-book-page-header">
        <div>
            <h1 class="admin-book-page-title">مدیریت کتاب‌ها</h1>
            <p class="admin-book-page-subtitle">
                فهرست کتاب‌ها و وضعیت نسخه‌های موجود در کتابخانه
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Book"
           asp-action="Create"
           class="admin-book-create-link">
            <span aria-hidden="true">+</span>
            افزودن کتاب
        </a>
    </header>

    <section class="admin-book-filter-card"
             aria-labelledby="admin-book-filter-title">

        <header class="admin-book-filter-header">
            <h2 id="admin-book-filter-title" class="admin-book-filter-title">
                جست‌وجو و فیلتر
            </h2>
            <p class="admin-book-filter-description">
                کتاب‌ها را بر اساس مشخصات و وضعیت موجودی محدود کنید.
            </p>
        </header>

        <form asp-area="Admin"
              asp-controller="Book"
              asp-action="Index"
              method="get"
              class="admin-book-filter-form">

            <div class="admin-book-filter-group admin-book-search-group">
                <label for="SearchTerm">جست‌وجو</label>
                <input id="SearchTerm"
                       name="SearchTerm"
                       type="search"
                       value="@filter.SearchTerm"
                       class="admin-book-filter-input"
                       placeholder="عنوان، نویسنده یا ناشر"
                       autocomplete="off" />
            </div>

            <div class="admin-book-filter-group">
                <label for="HasAvailableCopies">وضعیت موجودی</label>
                <select id="HasAvailableCopies"
                        name="HasAvailableCopies"
                        class="admin-book-filter-input">
                    <option value=""
                            selected="@(filter.HasAvailableCopies is null)">
                        همه کتاب‌ها
                    </option>
                    <option value="true"
                            selected="@(filter.HasAvailableCopies == true)">
                        دارای نسخهٔ موجود
                    </option>
                    <option value="false"
                            selected="@(filter.HasAvailableCopies == false)">
                        بدون نسخهٔ موجود
                    </option>
                </select>
            </div>

            <div class="admin-book-filter-group">
                <label for="HasActiveReservations">رزرو فعال</label>
                <select id="HasActiveReservations"
                        name="HasActiveReservations"
                        class="admin-book-filter-input">
                    <option value=""
                            selected="@(filter.HasActiveReservations is null)">
                        همه وضعیت‌ها
                    </option>
                    <option value="true"
                            selected="@(filter.HasActiveReservations == true)">
                        دارای رزرو فعال
                    </option>
                    <option value="false"
                            selected="@(filter.HasActiveReservations == false)">
                        بدون رزرو فعال
                    </option>
                </select>
            </div>

            <div class="admin-book-filter-group">
                <label for="SortBy">مرتب‌سازی بر اساس</label>
                <select id="SortBy"
                        name="SortBy"
                        class="admin-book-filter-input">
                    <option value="Title"
                            selected="@(filter.SortBy == "Title")">
                        عنوان
                    </option>
                    <option value="Author"
                            selected="@(filter.SortBy == "Author")">
                        نویسنده
                    </option>
                    <option value="PublicationYear"
                            selected="@(filter.SortBy == "PublicationYear")">
                        سال انتشار
                    </option>
                    <option value="TotalCopies"
                            selected="@(filter.SortBy == "TotalCopies")">
                        تعداد نسخه‌ها
                    </option>
                    <option value="AvailableCopies"
                            selected="@(filter.SortBy == "AvailableCopies")">
                        نسخه‌های موجود
                    </option>
                </select>
            </div>

            <div class="admin-book-filter-group">
                <label for="PageSize">تعداد در هر صفحه</label>
                <select id="PageSize"
                        name="PageSize"
                        class="admin-book-filter-input">
                    <option value="10"
                            selected="@(filter.PageSize == 10)">۱۰</option>
                    <option value="20"
                            selected="@(filter.PageSize == 20)">۲۰</option>
                    <option value="50"
                            selected="@(filter.PageSize == 50)">۵۰</option>
                </select>
            </div>

            <div class="admin-book-filter-group admin-book-sort-direction">
                <label for="SortDescending">جهت مرتب‌سازی</label>
                <select id="SortDescending"
                        name="SortDescending"
                        class="admin-book-filter-input">
                    <option value="false"
                            selected="@(!filter.SortDescending)">
                        صعودی
                    </option>
                    <option value="true"
                            selected="@(filter.SortDescending)">
                        نزولی
                    </option>
                </select>
            </div>

            <input type="hidden" name="Page" value="1" />

            <div class="admin-book-filter-actions">
                <button type="submit" class="admin-book-filter-submit">
                    اعمال فیلتر
                </button>

                <a asp-area="Admin"
                   asp-controller="Book"
                   asp-action="Index"
                   class="admin-book-filter-reset">
                    پاک کردن فیلترها
                </a>
            </div>
        </form>
    </section>

    <section class="admin-book-list-card"
             aria-labelledby="admin-book-list-title">

        <header class="admin-book-list-header">
            <div>
                <h2 id="admin-book-list-title" class="admin-book-list-title">
                    فهرست کتاب‌ها
                </h2>
                <p class="admin-book-list-description">
                    اطلاعات کتاب‌ها و وضعیت نسخه‌های آن‌ها
                </p>
            </div>

            <span class="admin-book-list-count">
                @Model.TotalCount کتاب
            </span>
        </header>

        @if (Model.Books.Count == 0)
        {
            <div class="admin-book-empty-state">
                <h3>کتابی پیدا نشد</h3>
                <p>
                    نتیجه‌ای با معیارهای انتخاب‌شده پیدا نشد.
                    فیلترها را تغییر دهید یا پاک کنید.
                </p>

                <a asp-area="Admin"
                   asp-controller="Book"
                   asp-action="Index"
                   class="admin-book-filter-reset">
                    نمایش همه کتاب‌ها
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive admin-book-table-wrapper">
                <table class="admin-book-table">
                    <thead>
                        <tr>
                            <th scope="col">شناسه</th>
                            <th scope="col">عنوان کتاب</th>
                            <th scope="col">نویسنده</th>
                            <th scope="col">ناشر</th>
                            <th scope="col">سال انتشار</th>
                            <th scope="col">کل نسخه‌ها</th>
                            <th scope="col">نسخه‌های موجود</th>
                            <th scope="col">رزروهای فعال</th>
                            <th scope="col">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var book in Model.Books)
                        {
                            <tr>
                                <td class="admin-book-id">
                                    @book.Id
                                </td>

                                <td class="admin-book-title-cell">
                                    @book.Title
                                </td>

                                <td>@book.Author</td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(book.Publisher)
                                        ? "—"
                                        : book.Publisher)
                                </td>

                                <td>@book.PublicationYear</td>

                                <td>
                                    <span class="admin-book-copy-count">
                                        @book.TotalCopies
                                    </span>
                                </td>

                                <td>
                                    @if (book.AvailableCopies > 0)
                                    {
                                        <span class="admin-book-copy-count admin-book-copy-available">
                                            @book.AvailableCopies
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="admin-book-copy-count admin-book-copy-unavailable">
                                            @book.AvailableCopies
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="admin-book-copy-count">
                                        @book.ActiveReservations
                                    </span>
                                </td>

                                <td>
                                    <a asp-area="Admin"
                                       asp-controller="Book"
                                       asp-action="Edit"
                                       asp-route-id="@book.Id"
                                       class="admin-book-edit-link">
                                        ویرایش
                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="Book"
                                       asp-action="Details"
                                       asp-route-bookId="@book.Id"
                                       class="admin-book-edit-link">
                                        جزئیات
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="admin-book-list-footer">
                <span>صفحه @currentPage از @totalPages</span>
                <span>@Model.Books.Count مورد در این صفحه</span>
            </footer>

            @if (totalPages > 1)
            {
                <nav class="admin-book-pagination"
                     aria-label="صفحه‌بندی کتاب‌ها">

                    @if (currentPage > 1)
                    {
                        <a asp-area="Admin"
                           asp-controller="Book"
                           asp-action="Index"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-HasAvailableCopies="@filter.HasAvailableCopies"
                           asp-route-HasActiveReservations="@filter.HasActiveReservations"
                           asp-route-SortBy="@filter.SortBy"
                           asp-route-SortDescending="@filter.SortDescending"
                           asp-route-PageSize="@filter.PageSize"
                           asp-route-Page="@(currentPage - 1)"
                           class="admin-book-pagination-link">
                            قبلی
                        </a>
                    }
                    else
                    {
                        <span class="admin-book-pagination-link is-disabled">
                            قبلی
                        </span>
                    }

                    <span class="admin-book-pagination-current">
                        @currentPage / @totalPages
                    </span>

                    @if (currentPage < totalPages)
                    {
                        <a asp-area="Admin"
                           asp-controller="Book"
                           asp-action="Index"
                           asp-route-SearchTerm="@filter.SearchTerm"
                           asp-route-HasAvailableCopies="@filter.HasAvailableCopies"
                           asp-route-HasActiveReservations="@filter.HasActiveReservations"
                           asp-route-SortBy="@filter.SortBy"
                           asp-route-SortDescending="@filter.SortDescending"
                           asp-route-PageSize="@filter.PageSize"
                           asp-route-Page="@(currentPage + 1)"
                           class="admin-book-pagination-link">
                            بعدی
                        </a>
                    }
                    else
                    {
                        <span class="admin-book-pagination-link is-disabled">
                            بعدی
                        </span>
                    }
                </nav>
            }
        }
    </section>
</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/admin/book/index.css"
          asp-append-version="true" />
}
