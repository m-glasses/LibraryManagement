@model RegisterViewModel

@{
    ViewData["Title"] = "ثبت نام";
}

<link rel="stylesheet"
      href="~/css/pages/account/register.css"
      asp-append-version="true" />

<div class="auth-page">
    <div class="auth-card">

        <div class="auth-header">
            <h1>ثبت نام</h1>
            <p>برای ایجاد حساب کاربری اطلاعات خود را وارد کنید.</p>
        </div>

        <form asp-controller="Account"
              asp-action="Register"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="auth-validation"
                 role="alert"></div>

            <div class="auth-form-grid">

                <div class="auth-field">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control" />
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Family"></label>
                    <input asp-for="Family" class="form-control" />
                    <span class="text-danger" asp-validation-for="Family"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="FatherName"></label>
                    <input asp-for="FatherName" class="form-control" />
                    <span class="text-danger" asp-validation-for="FatherName"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="DateOfBirth"></label>
                    <input data-jdp data-jdp-target-value-input="#gregorian-date"
                           data-jdp-target-value-type="gregorian"
                           class="form-control" type="text" />
                    <input id="gregorian-date" asp-for="DateOfBirth" class="form-control" type="text" hidden="hidden" />
                    <span class="text-danger" asp-validation-for="DateOfBirth"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Education"></label>
                    <select asp-for="Education"
                            asp-items="Html.GetEnumSelectList<EducationLevel>()"
                            class="form-select">
                        <option value="">انتخاب کنید</option>
                    </select>
                    <span class="text-danger" asp-validation-for="Education"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Gender"></label>
                    <select asp-for="Gender"
                            asp-items="Html.GetEnumSelectList<Gender>()"
                            class="form-select">
                        <option value="">انتخاب کنید</option>
                    </select>
                    <span class="text-danger" asp-validation-for="Gender"></span>
                </div>

                <div class="auth-field auth-field-full">
                    <label asp-for="Address"></label>
                    <textarea asp-for="Address"
                              class="form-control"
                              rows="3"></textarea>
                    <span class="text-danger" asp-validation-for="Address"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="UserName"></label>
                    <input asp-for="UserName"
                           class="form-control"
                           autocomplete="username" />
                    <span class="text-danger" asp-validation-for="UserName"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email"
                           class="form-control"
                           autocomplete="email" />
                    <span class="text-danger" asp-validation-for="Email"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="PhoneNumber"></label>
                    <input placeholder="09--------" asp-for="PhoneNumber"
                           class="form-control"
                           autocomplete="tel" />
                    <span class="text-danger" asp-validation-for="PhoneNumber"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password"
                           class="form-control"
                           autocomplete="new-password" />
                    <span class="text-danger" asp-validation-for="Password"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           autocomplete="new-password" />
                    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                </div>

            </div>

            <div class="auth-actions">
                <button type="submit" class="auth-submit">
                    ثبت نام
                </button>
            </div>

            <div class="auth-footer">
                <span>قبلاً حساب کاربری دارید؟</span>
                <a asp-controller="Account"
                   asp-action="Login">
                    ورود
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/vendor/jalalidatepicker.min.js"></script>
    <script src="~/js/pages/account/register.js"></script>
}
