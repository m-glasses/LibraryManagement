@model LibraryManagement.ViewModels.Book.BookDetailsViewModel

@{
    ViewData["Title"] = "جزئیات کتاب";
}

<div class="book-details-page">

    <header class="book-page-header">
        <div>
            <h1 class="book-page-title">جزئیات کتاب</h1>
            <p class="book-page-subtitle">
                مشخصات کتاب و وضعیت نسخه‌های موجود در کتابخانه
            </p>
        </div>
    </header>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="book-error-message" role="alert">
            @errorMessage
        </div>
    }

    <div class="book-details-card">

        @* Book Information *@
        <section class="book-details-section">
            <div class="book-details-section-header">
                <h2>مشخصات کتاب</h2>
            </div>

            <dl class="book-details-grid">

                <div class="book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Title)</dt>
                    <dd>@Model.Title</dd>
                </div>

                <div class="book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Author)</dt>
                    <dd>@Model.Author</dd>
                </div>

                <div class="book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Publisher)</dt>
                    <dd>
                        @(string.IsNullOrWhiteSpace(Model.Publisher)
                            ? "ثبت نشده"
                            : Model.Publisher)
                    </dd>
                </div>

                <div class="book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.PublicationYear)</dt>
                    <dd>@Model.PublicationYear</dd>
                </div>

                <div class="book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.PublicationSeason)</dt>
                    <dd>
                        @switch (Model.PublicationSeason)
                        {
                            case PublicationSeason.Spring:
                                @:بهار
                                break;

                            case PublicationSeason.Summer:
                                @:تابستان
                                break;

                            case PublicationSeason.Autumn:
                                @:پاییز
                                break;

                            case PublicationSeason.Winter:
                                @:زمستان
                                break;

                            default:
                                @:ثبت نشده
                                break;
                        }
                    </dd>
                </div>

                <div class="book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.PageCount)</dt>
                    <dd>@Model.PageCount</dd>
                </div>

                <div class="book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Edition)</dt>
                    <dd>@Model.Edition</dd>
                </div>

                <div class="book-details-item">
                    <dt>@Html.DisplayNameFor(model => model.Volume)</dt>
                    <dd>@Model.Volume</dd>
                </div>

            </dl>
        </section>

        @* Inventory Information *@
        <section class="book-details-section book-inventory-section">
            <div class="book-details-section-header">
                <h2>وضعیت موجودی</h2>
            </div>

            <dl class="book-inventory-grid">

                <div class="book-inventory-item">
                    <dt>@Html.DisplayNameFor(model => model.TotalCopies)</dt>
                    <dd>@Model.TotalCopies</dd>
                </div>

                <div class="book-inventory-item">
                    <dt>@Html.DisplayNameFor(model => model.AvailableCopies)</dt>
                    <dd>@Model.AvailableCopies</dd>
                </div>

                <div class="book-inventory-item">
                    <dt>وضعیت</dt>
                    <dd>
                        @if (Model.AvailableCopies > 0)
                        {
                            <span class="book-status book-status-available">
                                موجود
                            </span>
                        }
                        else
                        {
                            <span class="book-status book-status-unavailable">
                                ناموجود
                            </span>
                        }
                    </dd>
                </div>

            </dl>
        </section>

    </div>

    @* User Actions *@
    <div class="book-details-actions">

        @if (User.Identity?.IsAuthenticated == true)
        {
            if (Model.AvailableCopies > 0)
            {
                <form asp-controller="Loan"
                      asp-action="Borrow"
                      method="post"
                      class="book-borrow-form">

                    <input type="hidden"
                           name="bookId"
                           value="@Model.Id" />

                    <button type="submit" class="book-borrow-button">
                        درخواست امانت کتاب
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="Reservation"
                      asp-action="Reserve"
                      method="post"
                      class="book-reserve-form">

                    <input type="hidden"
                           name="bookId"
                           value="@Model.Id" />

                    <button type="submit" class="book-reserve-button">
                        رزرو کتاب
                    </button>
                </form>
            }
        }
        else
        {
            <a asp-controller="Account"
               asp-action="Login"
               class="book-borrow-button">
                برای امانت یا رزرو وارد شوید
            </a>
        }

        <a asp-controller="Book"
           asp-action="Index"
           class="book-back-link">
            بازگشت به فهرست کتاب‌ها
        </a>

    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/book/details.css"
          asp-append-version="true" />
}
