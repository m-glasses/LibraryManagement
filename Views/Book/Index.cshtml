@model LibraryManagement.ViewModels.Book.BookIndexViewModel

@{
    ViewData["Title"] = "کتاب‌ها";

    var filter = Model.Filter;
    var currentPage = Math.Max(1, filter.Page);
    var totalPages = Model.TotalPages;
}

<div class="book-page">

    <header class="book-page-header">
        <h1 class="book-page-title">کتاب‌ها</h1>
        <p class="book-page-subtitle">
            جست‌وجو و مشاهده کتاب‌های موجود در کتابخانه
        </p>
    </header>

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="book-error-message" role="alert">
            @errorMessage
        </div>
    }

    <section class="book-filter-card"
             aria-labelledby="book-filter-title">

        <div class="book-filter-header">
            <h2 id="book-filter-title" class="book-filter-heading">
                جست‌وجو و فیلتر کتاب‌ها
            </h2>
            <p class="book-filter-description">
                معیارهای موردنظر را انتخاب کنید.
            </p>
        </div>

        <form asp-controller="Book"
              asp-action="Index"
              method="get"
              class="book-filter-form">

            <input type="hidden" name="Page" value="1" />

            <div class="book-filter-grid">

                <div class="book-filter-field book-search-field">
                    <label for="SearchTerm" class="book-filter-label">
                        عنوان، نویسنده یا ناشر
                    </label>
                    <input id="SearchTerm"
                           name="SearchTerm"
                           type="search"
                           value="@filter.SearchTerm"
                           class="book-filter-input"
                           placeholder="جست‌وجوی کتاب..."
                           autocomplete="off" />
                </div>

                <div class="book-filter-field">
                    <label for="HasAvailableCopies" class="book-filter-label">
                        وضعیت موجودی
                    </label>
                    <select id="HasAvailableCopies"
                            name="HasAvailableCopies"
                            class="book-filter-select">
                        <option value=""
                                selected="@(filter.HasAvailableCopies is null)">
                            همه کتاب‌ها
                        </option>
                        <option value="true"
                                selected="@(filter.HasAvailableCopies == true)">
                            دارای نسخه موجود
                        </option>
                        <option value="false"
                                selected="@(filter.HasAvailableCopies == false)">
                            بدون نسخه موجود
                        </option>
                    </select>
                </div>

                <div class="book-filter-field">
                    <label for="HasActiveReservations" class="book-filter-label">
                        رزرو فعال
                    </label>
                    <select id="HasActiveReservations"
                            name="HasActiveReservations"
                            class="book-filter-select">
                        <option value=""
                                selected="@(filter.HasActiveReservations is null)">
                            همه وضعیت‌ها
                        </option>
                        <option value="true"
                                selected="@(filter.HasActiveReservations == true)">
                            دارای رزرو فعال
                        </option>
                        <option value="false"
                                selected="@(filter.HasActiveReservations == false)">
                            بدون رزرو فعال
                        </option>
                    </select>
                </div>

                <div class="book-filter-field">
                    <label for="SortBy" class="book-filter-label">
                        مرتب‌سازی بر اساس
                    </label>
                    <select id="SortBy"
                            name="SortBy"
                            class="book-filter-select">
                        <option value=""
                                selected="@(string.IsNullOrWhiteSpace(filter.SortBy))">
                            پیش‌فرض
                        </option>
                        <option value="Title"
                                selected="@(string.Equals(filter.SortBy, "Title", StringComparison.OrdinalIgnoreCase))">
                            عنوان کتاب
                        </option>
                        <option value="Author"
                                selected="@(string.Equals(filter.SortBy, "Author", StringComparison.OrdinalIgnoreCase))">
                            نویسنده
                        </option>
                        <option value="PublicationYear"
                                selected="@(string.Equals(filter.SortBy, "PublicationYear", StringComparison.OrdinalIgnoreCase))">
                            سال انتشار
                        </option>
                        <option value="TotalCopies"
                                selected="@(string.Equals(filter.SortBy, "TotalCopies", StringComparison.OrdinalIgnoreCase))">
                            تعداد کل نسخه‌ها
                        </option>
                        <option value="AvailableCopies"
                                selected="@(string.Equals(filter.SortBy, "AvailableCopies", StringComparison.OrdinalIgnoreCase))">
                            نسخه‌های موجود
                        </option>
                    </select>
                </div>

                <div class="book-filter-field">
                    <label for="SortDescending" class="book-filter-label">
                        جهت مرتب‌سازی
                    </label>
                    <select id="SortDescending"
                            name="SortDescending"
                            class="book-filter-select">
                        <option value="false"
                                selected="@(!filter.SortDescending)">
                            صعودی
                        </option>
                        <option value="true"
                                selected="@filter.SortDescending">
                            نزولی
                        </option>
                    </select>
                </div>

                <div class="book-filter-field">
                    <label for="PageSize" class="book-filter-label">
                        تعداد در هر صفحه
                    </label>
                    <select id="PageSize"
                            name="PageSize"
                            class="book-filter-select">
                        <option value="10" selected="@(filter.PageSize == 10)">
                            ۱۰ کتاب
                        </option>
                        <option value="20" selected="@(filter.PageSize == 20)">
                            ۲۰ کتاب
                        </option>
                        <option value="50" selected="@(filter.PageSize == 50)">
                            ۵۰ کتاب
                        </option>
                    </select>
                </div>

            </div>

            <div class="book-filter-actions">
                <button type="submit" class="book-filter-button">
                    اعمال فیلترها
                </button>

                <a asp-controller="Book"
                   asp-action="Index"
                   class="book-filter-reset">
                    پاک کردن فیلترها
                </a>
            </div>

        </form>
    </section>

    <section class="book-list-section" aria-label="فهرست کتاب‌ها">

        <div class="book-results-summary">
            <span>تعداد نتایج</span>
            <strong>@Model.TotalCount</strong>
        </div>

        <div class="book-list-card">
            <div class="book-table-wrapper">
                <table class="book-table">
                    <thead>
                        <tr>
                            <th scope="col">عنوان کتاب</th>
                            <th scope="col">نویسنده</th>
                            <th scope="col">ناشر</th>
                            <th scope="col">سال انتشار</th>
                            <th scope="col">تعداد کل نسخه‌ها</th>
                            <th scope="col">نسخه‌های موجود</th>
                            <th scope="col">رزروهای فعال</th>
                            <th scope="col">وضعیت</th>
                            <th scope="col" class="book-table-actions">عملیات</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Books.Count > 0)
                        {
                            foreach (var item in Model.Books)
                            {
                                <tr>
                                    <td class="book-table-title">@item.Title</td>
                                    <td>@item.Author</td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Publisher)
                                            ? "ثبت نشده"
                                            : item.Publisher)
                                    </td>
                                    <td>@item.PublicationYear</td>
                                    <td>@item.TotalCopies</td>
                                    <td>@item.AvailableCopies</td>
                                    <td>@item.ActiveReservations</td>
                                    <td>
                                        @if (item.AvailableCopies > 0)
                                        {
                                            <span class="book-status book-status-available">
                                                موجود
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="book-status book-status-unavailable">
                                                ناموجود
                                            </span>
                                        }
                                    </td>
                                    <td class="book-table-actions">
                                        <a asp-controller="Book"
                                           asp-action="Details"
                                           asp-route-bookId="@item.Id"
                                           class="book-details-link">
                                            مشاهده
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9">
                                    <div class="book-empty-state">
                                        <div class="book-empty-icon">
                                            <img src="~/images/icons/book.svg"
                                                 alt=""
                                                 width="32"
                                                 height="32" />
                                        </div>
                                        <h3>کتابی یافت نشد</h3>
                                        <p>
                                            کتابی با مشخصات انتخاب‌شده پیدا نشد.
                                            فیلترها را تغییر دهید یا پاک کنید.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    @if (totalPages > 1)
    {
        <nav class="book-pagination" aria-label="صفحه‌بندی کتاب‌ها">

            @if (currentPage > 1)
            {
                <a asp-controller="Book"
                   asp-action="Index"
                   asp-route-SearchTerm="@filter.SearchTerm"
                   asp-route-HasAvailableCopies="@filter.HasAvailableCopies"
                   asp-route-HasActiveReservations="@filter.HasActiveReservations"
                   asp-route-SortBy="@filter.SortBy"
                   asp-route-SortDescending="@filter.SortDescending"
                   asp-route-PageSize="@filter.PageSize"
                   asp-route-Page="@(currentPage - 1)"
                   class="book-pagination-link">
                    قبلی
                </a>
            }

            @for (var pageNumber = 1; pageNumber <= totalPages; pageNumber++)
            {
                if (pageNumber == currentPage)
                {
                    <span class="book-pagination-current"
                          aria-current="page">
                        @pageNumber
                    </span>
                }
                else
                {
                    <a asp-controller="Book"
                       asp-action="Index"
                       asp-route-SearchTerm="@filter.SearchTerm"
                       asp-route-HasAvailableCopies="@filter.HasAvailableCopies"
                       asp-route-HasActiveReservations="@filter.HasActiveReservations"
                       asp-route-SortBy="@filter.SortBy"
                       asp-route-SortDescending="@filter.SortDescending"
                       asp-route-PageSize="@filter.PageSize"
                       asp-route-Page="@pageNumber"
                       class="book-pagination-link">
                        @pageNumber
                    </a>
                }
            }

            @if (currentPage < totalPages)
            {
                <a asp-controller="Book"
                   asp-action="Index"
                   asp-route-SearchTerm="@filter.SearchTerm"
                   asp-route-HasAvailableCopies="@filter.HasAvailableCopies"
                   asp-route-HasActiveReservations="@filter.HasActiveReservations"
                   asp-route-SortBy="@filter.SortBy"
                   asp-route-SortDescending="@filter.SortDescending"
                   asp-route-PageSize="@filter.PageSize"
                   asp-route-Page="@(currentPage + 1)"
                   class="book-pagination-link">
                    بعدی
                </a>
            }

        </nav>
    }

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/book/index.css"
          asp-append-version="true" />
}
